    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/qrcode": "^1.5.6",
    "concurrently": "^9.1.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
